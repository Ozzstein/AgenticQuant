{
  "schema_version": "1.0",
  "name": "mean_reversion",
  "family": "mean_reversion",
  "origin": "declared_baseline",
  "model_name": "Linear",
  "features": [
    {
      "schema_version": "1.0",
      "name": "adv_20",
      "expression": "Mean(close * volume, 20)",
      "engine_version": "bounded-ast-1",
      "required_fields": [],
      "market_type": "any"
    },
    {
      "schema_version": "1.0",
      "name": "rsi_14",
      "expression": "If((Delta(close, 1).clip(lower=0).ewm(alpha=0.07142857142857142, min_periods=14, adjust=False).mean() == 0) & ((-Delta(close, 1)).clip(lower=0).ewm(alpha=0.07142857142857142, min_periods=14, adjust=False).mean() == 0), 50, If((-Delta(close, 1)).clip(lower=0).ewm(alpha=0.07142857142857142, min_periods=14, adjust=False).mean() == 0, 100, 100-100/(1+Delta(close, 1).clip(lower=0).ewm(alpha=0.07142857142857142, min_periods=14, adjust=False).mean()/(-Delta(close, 1)).clip(lower=0).ewm(alpha=0.07142857142857142, min_periods=14, adjust=False).mean())))",
      "engine_version": "bounded-ast-1",
      "required_fields": [],
      "market_type": "any"
    },
    {
      "schema_version": "1.0",
      "name": "price_zscore",
      "expression": "(close - Mean(close, 20)) / Std(close, 20)",
      "engine_version": "bounded-ast-1",
      "required_fields": [],
      "market_type": "any"
    },
    {
      "schema_version": "1.0",
      "name": "volatility_20",
      "expression": "Std((close / Ref(close, 1) - 1), 20) * 15.874507866387544",
      "engine_version": "bounded-ast-1",
      "required_fields": [],
      "market_type": "any"
    }
  ],
  "asset_classes": [
    "equity",
    "etf"
  ],
  "regimes": [
    "neutral"
  ],
  "cadence": "daily",
  "top_k": 20,
  "capital_fraction": 0.95,
  "position_cap": 0.1,
  "max_signal_age_seconds": 86400,
  "min_adv": 1000000.0,
  "entry_rules": [
    "RSI < 30 and price zscore < -1.5",
    "positive model prediction; most oversold first"
  ],
  "exit_rules": [
    "zscore >= 0",
    "held for 3 eligible sessions"
  ],
  "sizing": "equal",
  "max_holding_sessions": 3,
  "parameters": [
    [
      "minimum_prediction",
      0
    ],
    [
      "maximum_entry_rsi",
      30
    ],
    [
      "maximum_entry_zscore",
      -1.5
    ],
    [
      "exit_zscore",
      0
    ]
  ]
}
