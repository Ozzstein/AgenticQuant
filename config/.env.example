# QuantAgentLab API Keys
AIQUANT_ANTHROPIC_API_KEY=sk-ant-...
AIQUANT_OPENAI_API_KEY=sk-...
AIQUANT_FINNHUB_API_KEY=...
AIQUANT_COINGECKO_API_KEY=...
AIQUANT_FMP_API_KEY=
AIQUANT_FRED_API_KEY=
# SEC requires a declared operator/contact User-Agent.
AIQUANT_SEC_USER_AGENT=

# Durable paper account. Empty ledger path is derived from AIQUANT_OUTPUT_DIR.
AIQUANT_PAPER_LEDGER_PATH=
AIQUANT_PAPER_ACCOUNT_ID=paper:default
AIQUANT_PAPER_BASE_CURRENCY=USD
# AIQUANT_MODELS__WALK_FORWARD_MONTHS=6

# Telegram Bot (optional)
AIQUANT_MONITORING__TELEGRAM_TOKEN=
AIQUANT_MONITORING__TELEGRAM_CHAT_ID=

# SMTP Email (optional backup channel)
AIQUANT_MONITORING__SMTP_HOST=smtp.gmail.com
AIQUANT_MONITORING__SMTP_PORT=587
AIQUANT_MONITORING__SMTP_USER=your-email@gmail.com
AIQUANT_MONITORING__SMTP_PASSWORD=your-app-password
AIQUANT_MONITORING__SMTP_TO=alerts@yourcompany.com

# Alpaca Broker (optional)
AIQUANT_ALPACA__API_KEY=
AIQUANT_ALPACA__API_SECRET=
AIQUANT_ALPACA__PAPER=true

# CCXT Crypto Broker (optional — requires exchange API keys)
AIQUANT_CCXT__API_KEY=
AIQUANT_CCXT__API_SECRET=
AIQUANT_CCXT__EXCHANGE=binance
AIQUANT_CCXT__PAPER=true

# Override any config via env vars with AIQUANT_ prefix
# e.g. AIQUANT_LOG_LEVEL=DEBUG
